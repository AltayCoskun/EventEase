@page "/about"

<PageTitle>About Us - EventEase</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">About EventEase</h1>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title">Who We Are</h3>
                    <p class="lead">
                        EventEase is a premier corporate and social event management company dedicated to creating memorable experiences for our clients.
                    </p>
                    <p>
                        With years of experience in the industry, we specialize in organizing a wide range of events, from professional conferences and corporate gatherings to social celebrations and community events.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title">Our Mission</h3>
                    <p>
                        To simplify event management and make quality events accessible to everyone. We believe in the power of bringing people together and creating connections that last.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title">What We Offer</h3>
                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex">
                                <i class="bi bi-check-circle text-success fs-4 me-3"></i>
                                <div>
                                    <h5>Corporate Events</h5>
                                    <p class="text-muted">Professional conferences, workshops, and team-building activities.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex">
                                <i class="bi bi-check-circle text-success fs-4 me-3"></i>
                                <div>
                                    <h5>Social Events</h5>
                                    <p class="text-muted">Networking mixers, community gatherings, and celebrations.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex">
                                <i class="bi bi-check-circle text-success fs-4 me-3"></i>
                                <div>
                                    <h5>Easy Registration</h5>
                                    <p class="text-muted">Simple online registration with instant confirmation.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex">
                                <i class="bi bi-check-circle text-success fs-4 me-3"></i>
                                <div>
                                    <h5>Expert Support</h5>
                                    <p class="text-muted">Dedicated team to ensure your event experience is flawless.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/events" class="btn btn-primary btn-lg">
                    <i class="bi bi-calendar-event me-2"></i>Browse Our Events
                </a>
            </div>
        </div>
    </div>
</div>
