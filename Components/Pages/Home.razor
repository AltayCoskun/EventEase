@page "/"

<PageTitle>EventEase - Corporate & Social Event Management</PageTitle>

<div class="hero-section text-center py-5 mb-5">
    <h1 class="display-3 fw-bold mb-3">
        <i class="bi bi-calendar-heart text-primary"></i>
        Welcome to EventEase
    </h1>
    <p class="lead fs-4 text-muted mb-4">
        Your premier platform for corporate and social event management
    </p>
    <div>
        <a href="/events" class="btn btn-primary btn-lg me-2">
            <i class="bi bi-calendar-event me-2"></i>Browse Events
        </a>
        <a href="/about" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-info-circle me-2"></i>Learn More
        </a>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-search fs-1 text-primary"></i>
                    </div>
                    <h3 class="h4">Discover Events</h3>
                    <p class="text-muted">
                        Browse through a wide variety of corporate and social events tailored to your interests.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-clipboard-check fs-1 text-primary"></i>
                    </div>
                    <h3 class="h4">Easy Registration</h3>
                    <p class="text-muted">
                        Simple online registration process with instant confirmation and calendar integration.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-people fs-1 text-primary"></i>
                    </div>
                    <h3 class="h4">Connect & Network</h3>
                    <p class="text-muted">
                        Meet like-minded professionals and build meaningful connections at every event.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-6 mx-auto text-center">
            <h2 class="mb-4">Why Choose EventEase?</h2>
            <p class="lead text-muted">
                We make event management simple, accessible, and enjoyable. From corporate conferences to social gatherings, 
                we handle the details so you can focus on what matters most.
            </p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="d-flex">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h5>Professional Events</h5>
                    <p class="text-muted mb-0">High-quality corporate events, workshops, and conferences organized by experts.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h5>Social Gatherings</h5>
                    <p class="text-muted mb-0">Engaging networking events and community celebrations for all interests.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h5>Seamless Experience</h5>
                    <p class="text-muted mb-0">From browsing to registration, enjoy a smooth and intuitive platform.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h5>Instant Confirmation</h5>
                    <p class="text-muted mb-0">Get immediate confirmation and calendar invites for your registered events.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center py-5 bg-light rounded">
        <h2 class="mb-3">Ready to Get Started?</h2>
        <p class="lead text-muted mb-4">Join thousands of attendees and start exploring events today.</p>
        <a href="/events" class="btn btn-primary btn-lg">
            <i class="bi bi-calendar-event me-2"></i>View All Events
        </a>
    </div>
</div>

