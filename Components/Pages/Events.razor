@page "/events"
@using EventEase.Models
@using EventEase.Services
@inject EventService EventService
@rendermode InteractiveServer

<PageTitle>Events - EventEase</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">Browse Events</h1>

    @if (events == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading events...</p>
        </div>
    }
    else if (events.Count == 0)
    {
        <div class="alert alert-info">
            <p>No events available at this time.</p>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Filter by Category:</label>
            <select class="form-select" @onchange="OnCategoryChanged">
                <option value="">All Events</option>
                <option value="Corporate">Corporate</option>
                <option value="Social">Social</option>
            </select>
        </div>

        <div class="row">
            @foreach (var eventItem in filteredEvents)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Name</h5>
                            <p class="card-text">
                                <strong>Date:</strong> @eventItem.Date.ToString("MMM dd, yyyy - hh:mm tt")<br/>
                                <strong>Location:</strong> @eventItem.Location<br/>
                                <strong>Category:</strong> <span class="badge bg-primary">@eventItem.Category</span>
                            </p>
                            <p class="card-text text-muted">@eventItem.Description</p>
                            <div class="mt-3">
                                <small class="text-muted">
                                    Attendees: @eventItem.CurrentAttendees / @eventItem.MaxAttendees
                                </small>
                                <div class="progress mt-1" style="height: 5px;">
                                    <div class="progress-bar" 
                                         role="progressbar" 
                                         style="width: @GetAttendancePercentage(eventItem)%"
                                         aria-valuenow="@GetAttendancePercentage(eventItem)" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="/events/@eventItem.Id" class="btn btn-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Event>? events;
    private List<Event> filteredEvents = new();
    private string selectedCategory = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        events = await EventService.GetEventsAsync();
        filteredEvents = events;
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? string.Empty;
        
        if (string.IsNullOrEmpty(selectedCategory))
        {
            filteredEvents = events ?? new List<Event>();
        }
        else
        {
            filteredEvents = await EventService.GetEventsByCategoryAsync(selectedCategory);
        }
    }

    private double GetAttendancePercentage(Event eventItem)
    {
        if (eventItem.MaxAttendees == 0) return 0;
        return Math.Round((double)eventItem.CurrentAttendees / eventItem.MaxAttendees * 100, 2);
    }
}
